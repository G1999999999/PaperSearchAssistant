# ===== Online 模式模板（Chat 远程 + Embedding 本地）=====
# 复制为 .env.runtime 后填写真实密钥；切勿将含密钥的文件提交到 Git。
#   source scripts/use_mode.sh online

# 运行模式：online=远程，offline=本地
RAG_NETWORK_MODE=online

# 对话模型服务地址（OpenAI 兼容）
QWEN_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 对话模型 API Key（必填）
QWEN_CHAT_API_KEY=YOUR_API_KEY_HERE
# 对话模型名（示例：qwen3.5-plus / qwen-vl-plus）
QWEN_CHAT_MODEL=qwen3.5-plus
# 单次生成最大 token（回答长度上限）
QWEN_MAX_TOKENS=512
# 对话请求超时时间（秒）
QWEN_TIMEOUT=120

# 本地 embedding 模型路径或 HuggingFace 模型名（online/offline 统一使用）
LOCAL_EMBED_MODEL=BAAI/bge-m3
# 本地 embedding 设备：cpu / cuda / cuda:0 …
LOCAL_EMBED_DEVICE=cpu

# 兼容保留（当前代码默认不走远程 embedding）
QWEN_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_EMBED_API_KEY=YOUR_API_KEY_HERE
QWEN_EMBED_MODEL=text-embedding-v3

# 是否使用紧凑版 RAG 提示词：1=更短（省 token），0=详细（含推理结构）
RAG_USE_COMPACT_RAG_USER_PROMPT=1
# 每条检索片段最多拼接多少字符到提示词
RAG_CONTEXT_MAX_CHARS_PER_DOC=1200
# 所有检索片段总字符上限（0=不限制）
RAG_CONTEXT_TOTAL_MAX_CHARS=4000

# 本地命中不足时，联网补充最多合并多少条结果
RAG_WEB_MERGED_MAX_RESULTS=3
# 检索前是否先用 LLM 改写 query：1=开，0=关
RAG_LLM_QUERY_REWRITE=1
# 复合问题是否拆分子问题检索：1=开，0=关
RAG_SUBQUESTION_SPLIT=1

# 本地有命中时是否做“检索充分性评判”：
# off=关闭，on=每轮评判，auto=按路由规则决定
RAG_LLM_CONTEXT_SCORE=off
# auto 模式下是否额外用一次轻量 LLM 决策是否评判：1=开，0=关
RAG_AUTO_JUDGE_USE_LLM=1
# 评判阈值（0-10），低于该值可触发联网补充
RAG_CONTEXT_SCORE_MIN=6

# 本地无命中时是否允许联网兜底：1=开，0=关
RAG_WEB_FALLBACK=1
# 联网检索后端：auto / ddg_first / ddg_only
RAG_WEB_BACKEND=auto
# auto 模式下是否优先 Streamable HTTP MCP（mcpmarket 等）：1=是，0=否
RAG_WEB_STREAMABLE_FIRST=1
#
# --- Streamable HTTP MCP（可选；URL 含密钥勿入库）---
# MCP_ENABLED 中需包含 mcpmarket（或与 MCP_STREAMABLE_SERVER_NAME 相同）
# MCP_STREAMABLE_URL=https://mcpmarket.cn/mcp/your-endpoint-id
# MCP_STREAMABLE_BEARER=
# MCP_STREAMABLE_HEADERS_JSON=
# MCP_STREAMABLE_TOOL_NAME=search_engine
# MCP_STREAMABLE_SERVER_NAME=mcpmarket
# MCP_CALL_TIMEOUT_SECONDS=60
#
# use_tools 模式下，是否在首轮工具循环前先做「子问题拆分+联网(MCP优先)」并注入上下文：1=开
# RAG_TOOLS_PREFETCH_SUBQ_WEB=0
#
# 联网子问题并发数（1=串行，>1=并发）
RAG_WEB_SUBQUERY_MAX_CONCURRENT=1
# 子问题串行联网检索间隔（秒）
RAG_WEB_SUBQUERY_DELAY_SEC=0.45
# 联网时是否按子问题拆分：空=跟随 RAG_SUBQUESTION_SPLIT，1=强制拆分，0=强制不拆
RAG_WEB_SUBQUESTION_SPLIT=
# 是否启用 LangGraph 编排 chat 主流程（route -> RAG/Tools）
RAG_USE_LANGGRAPH=1

# Redis（可选）
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_PREFIX=psa2

# PostgreSQL（可选；Docker 见 docker-compose.postgres.yml，端口 15432）
# DATABASE_URL=postgresql+psycopg://papersearch:papersearch_dev@127.0.0.1:15432/papersearch
# RAG_PG_SYNC_ON_INGEST=1

# RAG/Agent 全链路流程日志（1=开启，0=关闭）
RAG_TRACE_ENABLED=0
# 日志文件（JSONL）
RAG_TRACE_LOG_FILE=data/logs/rag_agent_trace.jsonl
